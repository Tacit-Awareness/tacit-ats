# The client project: tacit-ats (ornhtusfsijbukqrxkek) since the cutover on
# 2026-11-09 (docs/client-cutover.md); the schema is this repo's supabase/
# track. SUPABASE_URL, the two keys, the signing key and SUPABASE_POOLER_URL
# go together.
SUPABASE_URL=https://ornhtusfsijbukqrxkek.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Server-only, never in a browser. apps/web's lib/client/bind.ts (first
# sign-in), lib/client/bot.ts and lib/notify/ (interview notifications to each
# company's bot), and apps/mcp's client/bind.ts + client/files.ts.
SUPABASE_SECRET_KEY=
# Server-only, apps/mcp. A private JWK the client project trusts (tacit-ats's
# own, docs/client-cutover.md step 5). It signs the 5-minute member token, and
# tacit_internal for the mcp_calls audit.
SUPABASE_TACIT_SIGNING_KEY=
SUPABASE_TACIT_SIGNING_KEY_ID=
# Server-only, apps/mcp (for now). The transaction pooler's connection string
# (Supabase dashboard > Connect > Transaction pooler, port 6543), read only
# inside packages/member-db: a member's direct Postgres transactions, run as
# `authenticated` with their token's claims so RLS decides. Its login role can
# become any role, so nothing else may read it (the apps' import tests).
# Unset = the tools that use it (whoami) fail with a sentence saying so.
SUPABASE_POOLER_URL=

# --- apps/mcp: /api/client, the MCP server members of client orgs add to Claude ---
# Unset (any of the two below, or SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY /
# SUPABASE_TACIT_SIGNING_KEY) = the route answers 503. Uses the WorkOS
# environment that holds the client organizations (the one the /client portal
# signs in with), not Tacit's staff connector's. In WorkOS: enable dynamic client
# registration and add CLIENT_MCP_RESOURCE_URL as a resource indicator.
# The signing key (above) signs a 5-minute
# member token (role authenticated, the user and their org) per request.
CLIENT_MCP_AUTHKIT_DOMAIN=
# e.g. https://ats-mcp.tacitawareness.com/api/client: the token audience and the
# URL a client pastes into Claude.
CLIENT_MCP_RESOURCE_URL=
# That environment's API key (the same value as the portal's WORKOS_API_KEY).
# Used only when a token lacks the user's org or, on a first sign-in, their
# email. Unset = both must be on the token.
CLIENT_WORKOS_API_KEY=
# Any value = list_files still works, but get_file_link and add_file refuse:
# for a project whose private `org-files` Storage bucket does not exist yet
# (apps/mcp/CLAUDE.md, "Files"). Unset = they sign links and upload through
# SUPABASE_SECRET_KEY.
CLIENT_FILES_DISABLED=
# The origin serving public job posts (apps/web's /jobs/[slug]), for the
# links list_job_posts and friends return, e.g. https://ats.tacitawareness.com.
# Unset = the tools return no link.
CLIENT_JOBS_ORIGIN=
# Candidate email from the client connector (draft_email / send_email) goes
# out through RESEND_API_KEY (unset = drafts only, send_email refuses),
# From CLIENT_EMAIL_FROM under the member's name with Reply-To the member's own
# address. CLIENT_EMAIL_FROM must be on a domain verified in Resend; defaults
# to hiring@tacitawareness.com. Any value in CLIENT_EMAIL_DISABLED turns
# drafting and sending off (templates still work). apps/web reads the same
# three for its reply box and Send here, with no default From: unless both
# RESEND_API_KEY and CLIENT_EMAIL_FROM are set on its Vercel project, email is
# off there and the pages say so.
CLIENT_EMAIL_FROM=
# The domain Resend receives on, the same on both apps. Set, each email's
# Reply-To is its own reply+<id>@ this domain: Resend posts the reply to apps/web's
# /api/webhooks/calendar-invite, which keeps it for the Inbox and forwards it to
# the member. Unset, Reply-To is the member's own address and the ATS sees none.
CLIENT_EMAIL_REPLY_DOMAIN=
CLIENT_EMAIL_DISABLED=
# Calendar scheduling (both apps): the Google OAuth client members connect
# their calendars to on apps/web's /client/calendar, and the connector
# refreshes those grants with. Unset = the Calendar page says it is not set
# up, find_interview_times refuses and interviews are recorded in Tacit only.
# One-time setup in Google Cloud: an OAuth client of type Web application,
# authorized redirect URI <web origin>/client/calendar/callback, the consent
# screen External with the scopes openid, email, calendar.freebusy and
# calendar.events (sensitive: Google must verify the app, or it is limited to
# 100 test users who see an unverified-app warning). The connector names the
# connect page from CLIENT_JOBS_ORIGIN (apps/web's origin).
# Gmail as Ashby does it (both apps): Tacit's Google service account, which a
# client company's Google Workspace admin authorizes by its unique ID for
# gmail.send and gmail.readonly (Admin console > Security > API controls >
# Domain-wide delegation); an admin verifies it in Settings, and everyone at
# that domain sends from their own address and has their email with
# candidates synced, with nothing to connect. Unset: only members' own
# connections below.
# Production signs with NO key (core's keylessDelegation): Vercel's OIDC token
# for this project goes through a Workload Identity pool to a federated token,
# which has IAM sign as the service account (the pool's principal for this
# project and environment needs Service Account Token Creator on it; the IAM
# Service Account Credentials and Security Token Service APIs enabled). All
# five, or none:
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_SERVICE_ACCOUNT_CLIENT_ID=
# Or, where key creation is allowed (local work), the service account's JSON
# key whole. The GCP_* settings win when both are set.
CLIENT_GOOGLE_SERVICE_ACCOUNT=
# The same client also connects members' own Gmail (apps/web's /client/mailbox,
# Settings > Gmail), so candidate email goes out from their own address and
# the notify cron reads the candidate's replies from the threads Tacit started.
# For that, also: the Gmail API enabled on the project, the authorized redirect
# URI <web origin>/client/mailbox/callback, and the scopes gmail.send
# (sensitive) and gmail.readonly (restricted: past 100 test users, Google's
# verification and a yearly CASA security assessment) on the consent screen.
CLIENT_GOOGLE_CLIENT_ID=
CLIENT_GOOGLE_CLIENT_SECRET=
# --- apps/web: client sign-in (the /client area) ---
# Who signs members in: unset (or `workos`) = WorkOS AuthKit, below; `supabase`
# = Supabase Auth on this project, with testbench's sign-in screen
# (@tacit-ats/auth-ui). The move off WorkOS. Supabase needs no keys of its own
# beyond SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY and (for invitations)
# SUPABASE_SECRET_KEY. One-time setup on the Supabase project:
#  1. Authentication > Hooks > Customize Access Token: public.custom_access_token_hook.
#  2. Authentication > Sign In / Providers: email on, sign-ups off (invite only),
#     leaked-password protection on, minimum length 8.
#  3. Authentication > URL Configuration: Site URL = the web origin
#     (https://ats.tacitawareness.com); the email links use it.
#  4. Authentication > Emails: custom SMTP (Resend), and the Invite user and
#     Reset password templates from supabase/templates/. (Dashboard edits did
#     not take on 2026-11-12; the Management API's PATCH config/auth with
#     mailer_subjects_* / mailer_templates_*_content did. Allow a minute or two.)
#  5. For the connector and tats (apps/mcp, the same flag there):
#     Authentication > OAuth Server: enabled, dynamic registration on,
#     authorization path /client/oauth/consent. And on apps/web,
#     CLIENT_MCP_RESOURCE_URL = the connector's URL (below): the consent page
#     approves only that resource.
CLIENT_AUTH_PROVIDER=
# With WorkOS, the whole /client area answers 404 until all three below are
# set, plus SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
#
# One-time setup, outside this repo:
#  1. WorkOS > Redirects: add <web origin>/client/callback as a redirect
#     URI, and set a default Sign-out URI.
#  2. WorkOS > Authentication > JWT template: ADD "role": "authenticated" to
#     the existing template (keep its email claims; the connector reads them).
#     `role` is what makes Supabase run the request as `authenticated`.
#     WorkOS already puts `org_id` in the token of an organization session,
#     which is what current_org_id() matches against orgs.workos_org_id.
#  3. Supabase > Authentication > Third-party auth: add WorkOS with the issuer
#     https://api.workos.com/user_management/<WORKOS_CLIENT_ID>.
#  4. One WorkOS Organization per client org, its id in orgs.workos_org_id.
WORKOS_CLIENT_ID=
# Seals the session cookie. At least 32 characters: `openssl rand -base64 24`.
WORKOS_COOKIE_PASSWORD=
# Optional: defaults to <request origin>/client/callback.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=
# The client WorkOS environment's API key (apps/web: invitations, sign-in).
WORKOS_API_KEY=
# Candidate email from the client connector (apps/mcp). Unset = drafts only.
RESEND_API_KEY=

# apps/web: interview notifications to each company's own bot (lib/notify/,
# /api/cron/notify every two minutes). CRON_SECRET authenticates Vercel's cron
# (Vercel sets it; unset = the route refuses). NOTIFY_REMINDER_TIMERS=off stops
# the exact five-minute reminder timers (Vercel Workflow), leaving the cron's
# own reminder, anywhere from T-5 to T-3.
CRON_SECRET=
NOTIFY_REMINDER_TIMERS=

# /api/cron/health every five minutes: pings Supabase's auth and REST planes
# and posts a message here when one hangs (the 2026-10-30 outage was auth
# hanging while anonymous REST stayed green -- a generic uptime check missed
# it). A Slack incoming-webhook URL; unset = failures only reach the logs.
ALERT_WEBHOOK_URL=

# --- apps/web: /api/bridge/*, tacit-internal's way into client orgs ---
# The HMAC secret tacit-internal signs bridge calls with (the same value as its
# CLIENT_BRIDGE_SECRET), 32+ characters; a comma-separated list while rotating.
# Unset = every /api/bridge path is a 404. docs/client-project-split.md.
TACIT_BRIDGE_SECRET=
