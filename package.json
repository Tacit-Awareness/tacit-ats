{
  "name": "tacit",
  "private": true,
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "ci:build": "pnpm -r --filter '!@tacit/internal' --filter '!@tacit/landing' --filter '!@tacit/mcp' build && pnpm -r --filter @tacit/internal --filter @tacit/landing --filter @tacit/mcp exec next typegen",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "pnpm -r clean",
    "build:functions": "pnpm --filter @tacit/core build:edge"
  },
  "devDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
